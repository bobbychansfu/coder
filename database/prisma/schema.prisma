generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  TA
  STUDENT
  GUEST
}

enum ContestStatus {
  DRAFT
  UPCOMING
  ACTIVE
  ENDED
}

// DRAFT is a retired value — never written by application code.
// Problem draft state is tracked via Problem.isDraft (Boolean).
// Contest draft state is tracked via ContestStatus.DRAFT.
enum ManageLifecycleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED
}

// How a contest's scoreboard ranks entries: by summed problem points, or by ICPC rules
// (problems solved, then penalty time).
enum ContestScoringRule {
  POINTS
  ICPC
}

enum Visibility {
  PUBLIC
  PRIVATE
  COURSE_ONLY
}

enum AnnouncementScope {
  PLATFORM
  CONTEST
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  SYSTEM_ERROR
  COMPILE_ERROR
}

enum CodingLanguage {
  CPLUSPLUS
  JAVA
  TYPESCRIPT
  JAVASCRIPT
  PYTHON
}

enum ProblemSource {
  PRACTICE
  CONTEST
  BOTH
}

enum ExperimentGroup {
  A
  B
  C
}

enum AssignmentMethod {
  MANUAL
  RANDOM
  RATIO_RANDOM
}

model User {
  id                       String   @id @default(cuid())
  computingId              String   @unique
  email                    String   @unique
  firstName                String
  lastName                 String
  nickname                 String?
  studentNumber            String?
  role                     UserRole
  pointsAcquired           Int      @default(0)
  problemsSolved           Int      @default(0)
  competitionsParticipated Int      @default(0)
  rank                     String?  @default("Beginner")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  teamMemberships        TeamMember[]
  contestsCreated        Contest[]               @relation("ContestCreator")
  announcements          Announcement[]          @relation("AnnouncementAuthor")
  submissions            Submission[]
  problemStatuses        ProblemStatus[]
  activities             UserActivity[]
  achievements           UserAchievement[]
  hints                  Hint[]
  participations         Participation[]
  practiceSessions       PracticeSession[]
  contestProblemSessions ContestProblemSession[]
  localCredential       LocalCredential?
  notifications          Notification[]
  teamInvitesReceived    TeamInvite[]            @relation("TeamInvitesReceived")
  teamInvitesSent        TeamInvite[]            @relation("TeamInvitesSent")
}

model LocalCredential {
  id           String    @id @default(cuid())
  userId       String    @unique
  username     String    @unique
  passwordHash String
  // Sessions issued before this moment are rejected, so changing a password signs out everywhere.
  passwordChangedAt DateTime @default(now())
  enabled      Boolean   @default(true)
  expiresAt    DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id          String       @id @default(cuid())
  name        String
  contestId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  submissions Submission[]
  invites     TeamInvite[]
  contest     Contest?     @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  // The team's contest (null for admin research groups), so a person can be on
  // only one team per contest
  contestId String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([contestId, userId])
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Joining a team needs the invitee's consent; the token makes a shareable link
model TeamInvite {
  id            String           @id @default(cuid())
  teamId        String
  invitedUserId String
  invitedById   String
  token         String           @unique
  status        TeamInviteStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User @relation("TeamInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("TeamInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([invitedUserId, status])
  @@index([teamId, status])
}

model PracticeSession {
  id            String          @id @default(cuid())
  userId        String
  problemId     String
  startedAt     DateTime        @default(now())
  firstRunAt    DateTime?
  firstSubmitAt DateTime?
  solvedAt      DateTime?
  selectedLang  CodingLanguage?
  runCount      Int             @default(0)
  submitCount   Int             @default(0)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  runs    PracticeRunRecord[]

  @@unique([userId, problemId])
  @@index([problemId])
}

model PracticeRunRecord {
  id            String         @id @default(cuid())
  sessionId     String
  userId        String
  problemId     String
  source        String         @default("practice")
  status        String         @default("queued")
  isSubmit      Boolean        @default(false)
  language      CodingLanguage
  code          String
  verdict       String
  score         Int?
  feedback      String?
  testcases     Json?
  judgedBy      String?
  rawProviderResponse Json?
  errorMessage  String?
  compilePassed Boolean        @default(false)
  stdout        String?
  stderr        String?
  runtimeMs     Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId, problemId, createdAt])
  @@index([status, updatedAt])
}

model Contest {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  description     String?
  classSection    String?
  type            String?
  location        String?
  status          ContestStatus @default(DRAFT)
  manageStatus    ManageLifecycleStatus @default(ACTIVE)
  visibility      Visibility    @default(PRIVATE)
  startsAt        DateTime
  endsAt          DateTime?
  durationMinutes Int?
  participants    Int           @default(0)
  published       Boolean       @default(false)
  aiHintEnabled   Boolean       @default(false)
  scoringRule     ContestScoringRule @default(POINTS)
  // Contestants see problem difficulty only when the setter turns this on.
  showDifficulty  Boolean       @default(false)
  // Once it ends, any student may open it and upsolve, registered or not
  openForUpsolving Boolean      @default(false)
  // Contestants per team; 1 makes it an individual contest
  maxTeamSize     Int           @default(3)
  // Secret in a private contest's join link; null turns the link off
  joinCode        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  instructorId String?
  instructor   User? @relation("ContestCreator", fields: [instructorId], references: [id], onDelete: SetNull)

  contestProblems        ContestProblem[]
  announcements          Announcement[]
  submissions            Submission[]
  problemStatuses        ProblemStatus[]
  participations         Participation[]
  experimentGroups       ContestExperimentGroup[]
  contestProblemSessions ContestProblemSession[]
  teams                  Team[]
  notifications          Notification[]
  allowedUsers           ContestAllowedUser[]
}

// Who may see and register for a private contest: a lowercased computing ID or email,
// matched against the signed-in user, so entries can name people before they sign up
model ContestAllowedUser {
  contestId  String
  identifier String
  createdAt  DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@id([contestId, identifier])
}

enum NotificationType {
  VERDICT
  TEAM_INVITE
}

// In-portal notifications shown under the navbar bell (and as toasts for verdicts)
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  contestId String?
  // Type-specific details, e.g. a verdict's problem letter, title, status and submitter
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Problem {
  id                 String        @id @default(cuid())
  code               String        @unique
  judgeProblemId     String?       @unique
  title              String
  statement          String
  inputFormat        String?
  outputFormat       String?
  constraints        String?
  exampleInput       String?
  exampleOutput      String?
  exampleExplanation String?
  difficulty         String
  isDraft            Boolean               @default(false)
  manageStatus       ManageLifecycleStatus @default(ACTIVE)
  visible            String?
  ap                 Int?
  author             String?
  timeConstraint     Int?
  memConstraint      Int?
  points             Int?
  source             ProblemSource @default(BOTH)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  starterCodes           ProblemStarterCode[]
  contestLinks           ContestProblem[]
  submissions            Submission[]
  problemStatuses        ProblemStatus[]
  topics                 Topic[]
  hints                  Hint[]
  practiceSessions       PracticeSession[]
  contestProblemSessions ContestProblemSession[]
}

model ProblemStarterCode {
  id            String         @id @default(cuid())
  problemId     String
  language      CodingLanguage
  code          String
  isAiGenerated Boolean        @default(false)
  generatedFrom CodingLanguage?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@index([problemId])
}

model ContestProblem {
  contestId String
  problemId String
  ordering  Int

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([contestId, problemId])
  @@unique([contestId, ordering])
}

model ContestExperimentGroup {
  id               String          @id @default(cuid())
  contestId        String
  groupName        ExperimentGroup
  aiHintEnabled    Boolean         @default(true)
  hintDelayMinutes Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, groupName])
  @@index([contestId])
}

model ContestProblemSession {
  id              String          @id @default(cuid())
  userId          String
  contestId       String
  problemId       String
  startedAt       DateTime        @default(now())
  firstRunAt      DateTime?
  firstSubmitAt   DateTime?
  hintEligibleAt  DateTime?
  hintTriggeredAt DateTime?
  solvedAt        DateTime?
  selectedLang    CodingLanguage?
  solved          Boolean         @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId, problemId])
  @@index([contestId, problemId])
  @@index([userId, contestId])
}

model ProblemStatus {
  userId      String
  contestId   String
  problemId   String
  status      String @default("not started")
  tries       Int    @default(0)
  timePenalty Int    @default(0)
  score       Int    @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, contestId, problemId])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  code        String?  @unique
  name        String
  description String?
  icon        Bytes?
  xpReward    Int      @default(0)
  topicId     String?

  userAchievements UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model Topic {
  id        String @id @default(cuid())
  name      String
  problemId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([name, problemId])
}

model Hint {
  id         String   @id @default(cuid())
  userId     String
  problemId  String
  code       String?
  feedback   String?
  validation String?
  hintNum    Int
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Participation {
  userId           String
  contestId        String
  role             String           @default("contestant")
  rank             Int?
  experimentGroup  ExperimentGroup?
  assignmentMethod AssignmentMethod?
  assignedAt       DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@id([userId, contestId])
  @@index([contestId, experimentGroup])
}

model Announcement {
  id        String            @id @default(cuid())
  title     String
  message   String
  scope     AnnouncementScope
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  authorId String?
  author   User? @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  contestId String?
  contest   Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String           @id @default(cuid())
  language    CodingLanguage
  submission  String?
  status      SubmissionStatus
  score       Int              @default(0)
  judgeOutput String?
  createdAt   DateTime         @default(now())

  userId    String
  contestId String
  problemId String
  // The submitter's team when it was made, so later roster changes never move results
  teamId    String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([contestId, problemId])
  @@index([userId, createdAt])
  @@index([teamId])
}
