POSTGRES_DB="coder_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
DB_PORT="5432"
SWAGGER_PORT="8081"

# Local development authentication
NEXT_PUBLIC_AUTH_MODE="dev"
AUTH_MODE="dev"
SESSION_COOKIE_NAME="session"
DEV_AUTH_COOKIE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
NEXT_PUBLIC_GUEST_LOGIN_ENABLED="true"
GUEST_LOGIN_ENABLED="true"
GUEST_AUTH_COOKIE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Local Coder API
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000/api"
AUTH_BACKEND_BASE_URL="http://localhost:3000"
AUTH_ME_PATH="/me"
AUTH_BACKEND_CAS_PATH="/"

# CAS is inactive while AUTH_MODE=dev, but these defaults keep the config complete.
CAS_LOGIN_BASE_URL="https://cas.sfu.ca/cas/login"
CAS_SERVICE_URL="https://coder.cmpt.sfu.ca/api/auth/cas/callback"

# Local SFU Judge and AI Hint API
JUDGE_URL="http://127.0.0.1:8000"
AI_HINT_URL="http://127.0.0.1:8000"

# Practice judging
JUDGING_MODE="gemini"
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Local cron authentication
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
