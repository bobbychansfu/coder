POSTGRES_DB="coder_db"
POSTGRES_USER="REPLACE_WITH_POSTGRES_USER"
POSTGRES_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
DB_PORT="1230"
SWAGGER_PORT="8081"
DATABASE_URL="postgresql://REPLACE_WITH_POSTGRES_USER@localhost:5432/coder_db?schema=public"

# Auth mode:
# - dev: enables quick demo access flow and local dev session cookie verification
# - cas: production CAS mode (dev quick access hidden)
NEXT_PUBLIC_AUTH_MODE="dev"
AUTH_MODE="dev"
SESSION_COOKIE_NAME="session"
DEV_AUTH_COOKIE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
NEXT_PUBLIC_GUEST_LOGIN_ENABLED="true"
GUEST_LOGIN_ENABLED="true"
GUEST_AUTH_COOKIE_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"
CAS_AUTH_COOKIE_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET"

# Backend API base URL used by frontend API client (/s, /i, /a)
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000/api"

# Backend auth/session endpoints consumed by Next server
AUTH_BACKEND_BASE_URL="http://localhost:3000"
AUTH_ME_PATH="/me"
AUTH_BACKEND_CAS_PATH="/"
CAS_LOGIN_BASE_URL="https://cas.sfu.ca/cas/login"
CAS_VALIDATE_URL="https://cas.sfu.ca/cas/serviceValidate"
# Exact fixed callback registered with SFU CAS. It must match the service used for ticket validation.
# CAS_SERVICE_URL="https://your-domain.example/api/auth/cas/callback"
JUDGE_URL="http://127.0.0.1:8000"
# Optional. If omitted, AI hints use JUDGE_URL and call /request_hint.
AI_HINT_URL="http://127.0.0.1:8000"
JUDGING_MODE="gemini"
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Optional override if you need a custom/full connection string.
# If omitted, the app builds it from POSTGRES_USER / POSTGRES_PASSWORD / DB_PORT / POSTGRES_DB.
# DATABASE_URL="postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@localhost:1230/judge?schema=public"
