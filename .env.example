POSTGRES_DB="judge"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
DB_PORT="5432"
SWAGGER_PORT="8081"

# Auth mode:
# - dev: enables quick demo access flow and local dev session cookie verification
# - cas: production CAS mode (dev quick access hidden)
NEXT_PUBLIC_AUTH_MODE="dev"
AUTH_MODE="dev"
SESSION_COOKIE_NAME="session"
DEV_AUTH_COOKIE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Backend API base URL used by frontend API client (/s, /i, /a)
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"

# Backend auth/session endpoints consumed by Next server
AUTH_BACKEND_BASE_URL="http://localhost:5000"
AUTH_ME_PATH="/me"
AUTH_BACKEND_CAS_PATH="/"
CAS_LOGIN_BASE_URL="https://cas.sfu.ca/cas/login"
JUDGE_URL="http://judge.cmpt.sfu.ca"
JUDGING_MODE="gemini"
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional override if you need a custom/full connection string.
# If omitted, the app builds it from POSTGRES_USER / POSTGRES_PASSWORD / DB_PORT / POSTGRES_DB.
# DATABASE_URL="postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@localhost:5432/judge?schema=public"
